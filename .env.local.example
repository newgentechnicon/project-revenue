# Supabase config — copy ไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# หาได้ที่ Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY_HERE

# Server only — ห้ามใช้ชื่อ NEXT_PUBLIC_ และห้ามส่งค่านี้ไป browser
# ใช้สำหรับหน้า Platform Admin ในการสร้างบริษัทและบัญชีผู้ใช้
# แนะนำ Secret key รูปแบบใหม่ (sb_secret_...) จาก Supabase Dashboard > Settings > API Keys
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY_HERE
# Legacy fallback (ไม่ต้องตั้งค่าถ้าใช้ SUPABASE_SECRET_KEY แล้ว)
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY_HERE
